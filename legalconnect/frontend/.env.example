# Leave empty in development (Vite proxies /api to http://localhost:5000).
# In production set the deployed backend API base URL, e.g. https://legalconnect-backend.onrender.com/api
VITE_API_URL=

# Socket.IO server URL (points to backend URL)
VITE_SOCKET_URL=http://localhost:5000

# Standalone Chatbot API URL
# In dev: defaults to http://localhost:5001/api/chat
# In prod: set to deployed chatbot URL, e.g. https://legalconnect-chatbot.onrender.com/api/chat
VITE_CHATBOT_API_URL=

# App name
VITE_APP_NAME=LegalConnect
