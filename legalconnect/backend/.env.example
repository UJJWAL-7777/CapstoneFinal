NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/legalconnect
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# Use 32+ random characters (see README)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# First admin account (used by npm run seed:admin)
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@legalconnect.local
ADMIN_PASSWORD=ChangeMe123!

# Cloudinary (for file and document attachments)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Razorpay (Authentic Payment Gateway - Test / Live Mode)
# Leave blank to use built-in Escrow Mock Simulation, or enter keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
